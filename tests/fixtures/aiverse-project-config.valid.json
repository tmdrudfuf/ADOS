{
  "project": {
    "id": "aiverse",
    "primary_repository_path": "C:/projects/aiverse",
    "default_branch": "main",
    "allowed_primary_local_paths": [
      ".claude",
      ".serena"
    ]
  },
  "bootstrap": {
    "commands": [
      "npm ci"
    ]
  },
  "execution_policy": {
    "schema_version": "1",
    "publication": {
      "merge_strategy": "merge"
    },
    "review": {
      "reviewer": "claude -p",
      "max_rounds": 5
    },
    "cleanup": {
      "autonomous": true
    },
    "guardian": {
      "stop_on_uncertain": true
    },
    "validation": {
      "commands": [
        "npm test",
        "npx tsc --noEmit",
        "npm run build",
        "git diff --check",
        "git diff --cached --check"
      ]
    }
  }
}
